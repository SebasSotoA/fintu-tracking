---
import Button from "@/components/ui/button.astro"
import { appUrl } from "@/lib/app-url"
import LandingNavMobile from "@/components/layout/landing-nav-mobile.astro"
---

<header class="sticky top-0 z-50 w-full border-b border-border/10 bg-background/35 backdrop-blur-md supports-[backdrop-filter]:bg-background/25">
  <div class="container mx-auto flex h-16 items-center justify-between px-6">
    <a
      href="/"
      class="flex items-center gap-2 rounded-lg outline-none transition-opacity hover:opacity-80 focus-visible:ring-2 focus-visible:ring-primary/40"
    >
      <img
        src="/fintu-aqua-icon.svg"
        alt=""
        width="28"
        height="28"
        class="h-7 w-7 object-contain mix-blend-screen"
      />
      <span class="font-sans text-sm font-bold tracking-tight text-foreground">Fintu</span>
    </a>

    <nav class="hidden items-center gap-1 md:flex" aria-label="Main">
      <a
        href="#features"
        class="rounded-lg px-4 py-2 text-sm font-medium text-foreground/60 outline-none transition-all duration-200 hover:bg-primary/5 hover:text-foreground/90 focus-visible:ring-2 focus-visible:ring-primary/40"
      >
        Features
      </a>
    </nav>

    <div class="flex items-center gap-2">
      <div class="hidden items-center gap-3 md:flex">
        <Button href={appUrl("/auth/login")} variant="ghost" size="sm">Login</Button>
        <Button href={appUrl("/auth/sign-up")} size="sm">Get Started</Button>
      </div>
      <LandingNavMobile isAuthenticated={false} />
    </div>
  </div>
</header>