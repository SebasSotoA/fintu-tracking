---
import Button from "@/components/ui/button.astro"
import { cn } from "@/lib/utils"
import { MARKET_CONFIG } from "@/lib/market-config"
import { appUrl } from "@/lib/app-url"

const precisionMetrics = [
  {
    label: `Local currency → ${MARKET_CONFIG.baseCurrency}`,
    value: "4,127.50",
    delta: "trade-date FX",
  },
  { label: "XIRR", value: "+12.4%", delta: "annualized" },
  { label: "Net worth", value: "$48,291", delta: `${MARKET_CONFIG.baseCurrency} basis` },
] as const

const fxTerms = [
  { term: "FX", desc: "Historical local FX rates" },
  { term: "Fees", desc: "Broker fees in basis" },
  { term: "XIRR", desc: "True returns" },
]
---

<section class="relative container mx-auto px-6 pb-20 pt-14 md:pb-28 md:pt-20">
  <div class="grid items-center gap-12 lg:grid-cols-[1.05fr_0.95fr] lg:gap-16">
    <div class="max-w-xl landing-fade-up">
      <p class="mb-5 inline-flex items-center gap-2 rounded-full border border-primary/25 bg-primary/10 px-3 py-1 text-xs font-medium tracking-wide text-primary-text uppercase">
        <span class="size-1.5 rounded-full bg-primary"></span>
        Built for LATAM retail investors
      </p>
      <h1
        class={cn(
          "font-sans text-4xl font-bold leading-[1.08] tracking-tight text-balance sm:text-5xl md:text-6xl lg:text-[3.5rem]",
        )}
      >
        US assets through your local broker
        <span class="mt-1 block text-primary-text">tracked with precision</span>
      </h1>
      <p class="mt-6 max-w-lg text-lg leading-relaxed text-muted-foreground text-pretty">
        Fintu accounts for local-currency↔{MARKET_CONFIG.baseCurrency} FX, broker fees, and cost basis
        so you see real performance—not guesswork—across every US holding.
      </p>
      <div class="mt-8 flex flex-wrap items-center gap-3">
        <Button href={appUrl("/auth/sign-up")} size="lg" className="gap-2">
          Get Started
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="size-4"
            aria-hidden="true"
          >
            <path d="M5 12h14"></path>
            <path d="m12 5 7 7-7 7"></path>
          </svg>
        </Button>
        <Button href={appUrl("/auth/login")} variant="outline" size="lg">Login</Button>
      </div>
      <dl class="mt-10 grid grid-cols-1 sm:grid-cols-3 gap-4 border-t border-border/40 pt-8">
        {fxTerms.map((item) => (
          <div>
            <dt class="font-mono text-sm font-medium text-primary-text">{item.term}</dt>
            <dd class="mt-1 text-xs text-muted-foreground">{item.desc}</dd>
          </div>
        ))}
      </dl>
    </div>

    <div class="relative mx-auto w-full max-w-md lg:mx-0 lg:ml-auto lg:max-w-none landing-fade-up-delayed">
      <div class="relative overflow-hidden rounded-2xl border border-border/60 bg-surface-container/80 shadow-2xl shadow-black/40 landing-float">
        <div class="flex items-center justify-between border-b border-border/50 bg-surface-container-high/80 px-4 py-3">
          <span class="font-mono text-[11px] tracking-widest text-muted-foreground uppercase">
            Precision snapshot
          </span>
          <span class="flex items-center gap-1.5 font-mono text-[10px] text-primary-text">
            <span class="size-1.5 rounded-full bg-primary"></span>
            Live mock
          </span>
        </div>
        <div class="space-y-0 divide-y divide-border/40 p-1">
          {precisionMetrics.map((metric, index) => (
            <div
              class="flex items-baseline justify-between gap-4 px-4 py-4 landing-fade-up-metric"
              style={`animation-delay: ${180 + index * 80}ms`}
            >
              <div>
                <p class="text-xs text-muted-foreground">{metric.label}</p>
                <p class="mt-1 font-mono text-2xl font-medium tracking-tight text-foreground">
                  {metric.value}
                </p>
              </div>
              <span class="font-mono text-[10px] tracking-wide text-primary-text uppercase">
                {metric.delta}
              </span>
            </div>
          ))}
        </div>
        <div class="border-t border-border/50 bg-surface-container-low/60 px-4 py-3">
          <p class="font-mono text-[10px] leading-relaxed text-muted-foreground">
            Fees · FX · cost basis reconciled · performance in {MARKET_CONFIG.baseCurrency} & local currency
          </p>
        </div>
      </div>
    </div>
  </div>
</section>