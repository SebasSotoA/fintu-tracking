---
import Card from "@/components/ui/card.astro"
import CardContent from "@/components/ui/card-content.astro"
import { cn } from "@/lib/utils"
import { MARKET_CONFIG } from "@/lib/market-config"

const features = [
  {
    id: "multi-currency",
    title: "Local Currency Deposits",
    description: `Track local currency deposits into ${MARKET_CONFIG.baseCurrency} with historical FX rates applied at each trade date, not today's spot rate.`,
    icon: "trending-up",
    accent: "from-[var(--landing-gradient-mint-start)] via-[var(--landing-gradient-mint-mid)] to-transparent",
  },
  {
    id: "cost-basis",
    title: "Broker Fees in Basis",
    description: "Average cost method with every broker fee (deposit, transfer, and trading) rolled into your true entry price.",
    icon: "dollar-sign",
    accent: "from-[var(--landing-gradient-mint-start)] via-[var(--landing-gradient-mint-mid)] to-transparent",
  },
  {
    id: "portfolio",
    title: "US Holdings View",
    description: `US stocks, ETFs, and crypto: allocation and P/L in ${MARKET_CONFIG.baseCurrency} and your local currency, side by side.`,
    icon: "pie-chart",
    accent: "from-[var(--landing-gradient-mint-start)] via-[var(--landing-gradient-mint-mid)] to-transparent",
  },
  {
    id: "performance",
    title: "True Performance",
    description:
      "XIRR and fee-impact analysis that reflect how your capital actually compounded over time.",
    icon: "bar-chart-3",
    accent: "from-[var(--landing-gradient-mint-start)] via-[var(--landing-gradient-mint-mid)] to-transparent",
  },
] as const
---

<section id="features" class="relative border-t border-border/30 bg-surface-container-lowest/50">
  <div class="container mx-auto px-6 py-20 md:py-28">
    <div class="mb-12 max-w-2xl md:mb-16 landing-fade-up">
      <p class="font-mono text-xs tracking-widest text-primary-text uppercase">Capabilities</p>
      <h2
        class={cn(
          "font-sans mt-3 text-3xl font-bold tracking-tight text-balance sm:text-4xl md:text-[2.75rem]",
        )}
      >
        Every pillar of precision tracking
      </h2>
      <p class="mt-4 text-muted-foreground text-pretty">
        From local currency deposits to US-market holdings. Fintu is built around the numbers LATAM
        investors actually need.
      </p>
    </div>

    <div class="grid gap-4 md:grid-cols-2 md:grid-rows-2 md:gap-5">
      {features.map((feature, index) => (
        <Card
          variant="interactive"
          className="group relative overflow-hidden border-border/50 bg-surface-container/60 py-0 landing-fade-up-stagger"
          style={`animation-delay: ${100 + index * 70}ms`}
        >
          <div
            aria-hidden="true"
            class={cn(
              "pointer-events-none absolute inset-0 bg-gradient-to-br opacity-80 transition-opacity duration-500 group-hover:opacity-100",
              feature.accent,
            )}
          />
          <CardContent className="relative flex h-full flex-col justify-between gap-6 p-5 md:p-6">
            <div class="flex items-start justify-between gap-4">
              <div class="rounded-xl border border-primary/20 bg-primary/10 p-3 transition-colors duration-300 group-hover:border-primary/35 group-hover:bg-primary/15">
                {feature.icon === "trending-up" && (
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="20"
                    height="20"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.75"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    class="size-5 text-primary-text"
                    aria-hidden="true"
                  >
                    <polyline points="22 7 13.5 15.5 8.5 10.5 2 17"></polyline>
                    <polyline points="16 7 22 7 22 13"></polyline>
                  </svg>
                )}
                {feature.icon === "dollar-sign" && (
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="20"
                    height="20"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.75"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    class="size-5 text-primary-text"
                    aria-hidden="true"
                  >
                    <line x1="12" x2="12" y1="2" y2="22"></line>
                    <path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path>
                  </svg>
                )}
                {feature.icon === "pie-chart" && (
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="20"
                    height="20"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.75"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    class="size-5 text-primary-text"
                    aria-hidden="true"
                  >
                    <path d="M21 12c.552 0 1.005-.449.95-.998a10 10 0 0 0-8.953-8.951c-.55-.055-.998.398-.998.95v8a1 1 0 0 0 1 1z"></path>
                    <path d="M21.21 15.89A10 10 0 1 1 8 2.83"></path>
                  </svg>
                )}
                {feature.icon === "bar-chart-3" && (
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="20"
                    height="20"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.75"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    class="size-5 text-primary-text"
                    aria-hidden="true"
                  >
                    <path d="M3 3v16a2 2 0 0 0 2 2h16"></path>
                    <path d="M18 17V9"></path>
                    <path d="M13 17V5"></path>
                    <path d="M8 17v-3"></path>
                  </svg>
                )}
              </div>
              <span class="font-mono text-[10px] tracking-widest text-muted-foreground/70 uppercase">
                0{index + 1}
              </span>
            </div>
            <div>
              <h3 class="font-sans text-xl tracking-tight">{feature.title}</h3>
              <p class="mt-3 text-sm leading-relaxed text-muted-foreground">{feature.description}</p>
            </div>
          </CardContent>
        </Card>
      ))}
    </div>
  </div>
</section>